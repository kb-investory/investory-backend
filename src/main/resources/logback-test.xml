<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- 우리 애플리케이션 코드는 테스트 중 DEBUG로 자세히 -->
    <logger name="com.kbinvestory.backend" level="DEBUG"/>

    <!-- MyBatis가 실행하는 SQL과 바인딩 파라미터를 보고 싶을 때 사용 -->
    <!-- Mapper 인터페이스 패키지명에 맞게 수정하세요 -->
    <logger name="com.kbinvestory.backend.mapper" level="DEBUG"/>

    <!-- HikariCP 커넥션 풀 상태 확인용 (필요 없으면 지워도 됨) -->
    <logger name="com.zaxxer.hikari" level="INFO"/>

    <!-- Spring 프레임워크 내부 로그는 테스트에서 시끄러우니 WARN으로 억제 -->
    <logger name="org.springframework" level="WARN"/>

    <!-- Spring Security 디버깅이 필요할 때만 DEBUG로 올리세요 -->
    <logger name="org.springframework.security" level="WARN"/>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>

</configuration>