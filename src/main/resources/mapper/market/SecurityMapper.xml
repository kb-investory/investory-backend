<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.investory.market.infra.mappers.SecurityMapper">
    <resultMap id="securityRowMap" type="com.investory.market.infra.entities.SecurityRow">
        <id property="securityId" column="security_id"/>
        <result property="securityCode" column="security_code"/>
        <result property="securityName" column="security_name"/>
        <result property="marketType" column="market_type"/>
        <result property="sectorCode" column="sector_code"/>
        <result property="sectorName" column="sector_name"/>
        <result property="industryName" column="industry_name"/>
        <result property="listedDate" column="listed_date"/>
        <result property="delistedDate" column="delisted_date"/>
        <result property="active" column="is_active"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <sql id="securityColumns">
        security_id, security_code, security_name, market_type,
        sector_code, sector_name, industry_name,
        listed_date, delisted_date, is_active, created_at, updated_at
    </sql>

    <sql id="searchWhere">
        <where>
            <if test="keyword != null and keyword != ''">
                AND (security_name LIKE CONCAT('%', #{keyword}, '%')
                OR security_code LIKE CONCAT('%', #{keyword}, '%'))
            </if>
            <if test="marketType != null">
                AND market_type = #{marketType}
            </if>
        </where>
    </sql>

    <select id="findBySecurityCode" resultMap="securityRowMap">
        SELECT <include refid="securityColumns"/>
        FROM securities
        WHERE security_code = #{securityCode}
    </select>

    <select id="findBySecurityId" resultMap="securityRowMap">
        SELECT <include refid="securityColumns"/>
        FROM securities
        WHERE security_id = #{securityId}
    </select>

    <select id="findBySecurityIds" resultMap="securityRowMap">
        SELECT <include refid="securityColumns"/>
        FROM securities
        WHERE security_id IN
        <foreach item="id" collection="securityIds" open="(" separator="," close=")">
            #{id}
        </foreach>
    </select>

    <select id="findBySecurityCodes" resultMap="securityRowMap">
        SELECT <include refid="securityColumns"/>
        FROM securities
        WHERE security_code IN
        <foreach item="code" collection="securityCodes" open="(" separator="," close=")">
            #{code}
        </foreach>
    </select>

    <select id="findAllSecurityCodes" resultType="string">
        SELECT security_code
        FROM securities
        ORDER BY security_code
    </select>

    <select id="search" resultMap="securityRowMap">
        SELECT <include refid="securityColumns"/>
        FROM securities
        <include refid="searchWhere"/>
        ORDER BY security_code
        LIMIT #{limit} OFFSET #{offset}
    </select>

    <select id="countSearch" resultType="long">
        SELECT COUNT(*)
        FROM securities
        <include refid="searchWhere"/>
    </select>

    <insert id="insert" parameterType="com.investory.market.infra.entities.SecurityRow"
            useGeneratedKeys="true" keyProperty="securityId" keyColumn="security_id">
        INSERT INTO securities (
        security_code, security_name, market_type,
        sector_code, sector_name, industry_name,
        listed_date, delisted_date,
        is_active, created_at, updated_at
        ) VALUES (
        #{securityCode}, #{securityName}, #{marketType},
        #{sectorCode}, #{sectorName}, #{industryName},
        #{listedDate}, #{delistedDate},
        #{active}, #{createdAt}, #{updatedAt}
        )
    </insert>

    <!-- created_at은 절대 건드리지 않는다 (최초 생성 시각 보존) -->
    <update id="update" parameterType="com.investory.market.infra.entities.SecurityRow">
        UPDATE securities
        SET security_name  = #{securityName},
        market_type    = #{marketType},
        sector_code    = #{sectorCode},
        sector_name    = #{sectorName},
        industry_name  = #{industryName},
        listed_date    = #{listedDate},
        delisted_date  = #{delistedDate},
        is_active      = #{active},
        updated_at     = #{updatedAt}
        WHERE security_code = #{securityCode}
    </update>
</mapper>
