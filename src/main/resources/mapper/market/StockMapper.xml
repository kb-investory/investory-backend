<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.kbinvestory.backend.market.infra.mappers.StockMapper">

    <resultMap id="stockRowResultMap" type="com.kbinvestory.backend.market.infra.entities.StockRow">
        <id column="stock_id" property="stockId"/>
        <result column="stock_code" property="stockCode"/>
        <result column="stock_name" property="stockName"/>
        <result column="market" property="market"/>
        <result column="sector" property="sector"/>
        <result column="listed_date" property="listedDate"/>
        <result column="created_at" property="createdAt"/>
        <result column="updated_at" property="updatedAt"/>
    </resultMap>

    <sql id="searchCondition">
        <where>
            <if test="keyword != null and keyword != ''">
                AND (stock_code LIKE CONCAT('%', #{keyword}, '%')
                     OR stock_name LIKE CONCAT('%', #{keyword}, '%'))
            </if>
            <if test="market != null">
                AND market = #{market}
            </if>
            <if test="sector != null and sector != ''">
                AND sector = #{sector}
            </if>
        </where>
    </sql>

    <select id="search" resultMap="stockRowResultMap">
        <bind name="offset" value="page * size"/>
        SELECT
            stock_id,
            stock_code,
            stock_name,
            market,
            sector,
            listed_date,
            created_at,
            updated_at
        FROM stock
        <include refid="searchCondition"/>
        ORDER BY stock_id
        LIMIT #{size} OFFSET #{offset}
    </select>

    <select id="count" resultType="long">
        SELECT COUNT(*)
        FROM stock
        <include refid="searchCondition"/>
    </select>

</mapper>