<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.kbinvestory.backend.account.infra.mappers.BrokerageProviderMapper">

    <resultMap id="brokerageProviderRowResultMap" type="com.kbinvestory.backend.account.infra.entities.BrokerageProviderRow">
        <id column="provider_id" property="providerId"/>
        <result column="provider_code" property="providerCode"/>
        <result column="provider_name" property="providerName"/>
        <result column="active_yn" property="active"/>
        <result column="created_at" property="createdAt"/>
        <result column="updated_at" property="updatedAt"/>
    </resultMap>

    <select id="search" resultMap="brokerageProviderRowResultMap">
        SELECT
            provider_id,
            provider_code,
            provider_name,
            active_yn,
            created_at,
            updated_at
        FROM brokerage_providers
        WHERE active_yn = TRUE
        <if test="keyword != null and keyword != ''">
            AND (provider_code LIKE CONCAT('%', #{keyword}, '%')
                 OR provider_name LIKE CONCAT('%', #{keyword}, '%'))
        </if>
        ORDER BY provider_id
    </select>

    <select id="findById" resultMap="brokerageProviderRowResultMap">
        SELECT
            provider_id,
            provider_code,
            provider_name,
            active_yn,
            created_at,
            updated_at
        FROM brokerage_providers
        WHERE provider_id = #{providerId}
          AND active_yn = TRUE
    </select>

</mapper>